{
  "name": "notcms",
  "version": "1.1.0",
  "description": "NotCMS makes it easy to create a CMS, from Notion.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "notcms": "./dist/cli.cjs"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf ./dist/",
    "format": "biome format --write .",
    "lint-biome": "biome lint --write .",
    "check": "biome check .",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "fix": "biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qqpann/notcms.git",
    "directory": "packages/notcms"
  },
  "license": "MIT",
  "author": {
    "name": "Qiushi Pan",
    "email": "17402261+qqpann@users.noreply.github.com",
    "url": "https://github.com/qqpann"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "notcms",
    "cms",
    "headless cms",
    "content management system",
    "notion",
    "markdown",
    "ts",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/qqpann/notcms/issues"
  },
  "homepage": "https://github.com/qqpann/notcms#readme",
  "dependencies": {},
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@inquirer/prompts": "^8.8.0",
    "@types/node": "^26.6.6",
    "acorn": "8.19.0",
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "dedent": "^1.7.2",
    "tsup": "^8.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  }
}
