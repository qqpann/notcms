{
  "$schema": "https://mintlify.com/docs.json",
  "name": "NotCMS",
  "logo": {
    "dark": "/assets/notcms-icon.png",
    "light": "/assets/notcms-icon.png",
    "href": "https://www.notcms.com"
  },
  "favicon": "/assets/notcms-icon.png",
  "theme": "mint",
  "colors": {
    "primary": "#BE185D",
    "light": "#FF5CAD",
    "dark": "#BE185D"
  },
  "appearance": {
    "default": "dark"
  },
  "navbar": {
    "links": [
      {
        "label": "Homepage",
        "href": "https://www.notcms.com"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/qqpann/notcms"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://dash.notcms.com"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Templates",
          "icon": "rectangle-terminal",
          "href": "https://www.notcms.com/templates"
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://www.notcms.com/blog"
        }
      ]
    },
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["en/introduction", "en/quickstart"]
          },
          {
            "group": "Usage",
            "pages": [
              "en/usage/initializing-client",
              "en/usage/list",
              "en/usage/get",
              "en/usage/errors-and-rate-limits"
            ]
          },
          {
            "group": "CLI Commands",
            "pages": [
              "en/cli-commands/init",
              "en/cli-commands/pull",
              "en/cli-commands/migration",
              "en/cli-commands/schema-ci"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "en/examples/nextjs",
              "en/examples/blog-releases",
              "en/examples/content-recipes",
              "en/examples/astro"
            ]
          }
        ]
      },
      {
        "language": "ja",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["ja/introduction", "ja/quickstart"]
          },
          {
            "group": "Usage",
            "pages": [
              "ja/usage/initializing-client",
              "ja/usage/list",
              "ja/usage/get",
              "ja/usage/errors-and-rate-limits"
            ]
          },
          {
            "group": "CLI Commands",
            "pages": [
              "ja/cli-commands/init",
              "ja/cli-commands/pull",
              "ja/cli-commands/migration",
              "ja/cli-commands/schema-ci"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "ja/examples/nextjs",
              "ja/examples/blog-releases",
              "ja/examples/content-recipes",
              "ja/examples/astro"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/qqpann/notcms"
    }
  },
  "search": {
    "prompt": "Search documentation..."
  }
}
