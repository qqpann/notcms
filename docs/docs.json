{
  "$schema": "https://mintlify.com/docs.json",
  "name": "NotCMS",
  "logo": {
    "dark": "/assets/notcms-icon.png",
    "light": "/assets/notcms-icon.png",
    "href": "https://www.notcms.com"
  },
  "favicon": "/assets/notcms-icon.png",
  "theme": "mint",
  "colors": {
    "primary": "#000000"
  },
  "modeToggle": {
    "default": "dark"
  },
  "topbarLinks": [
    {
      "name": "Homepage",
      "url": "https://www.notcms.com"
    },
    {
      "name": "GitHub",
      "url": "https://github.com/qqpann/notcms"
    }
  ],
  "topbarCtaButton": {
    "name": "Get Started",
    "url": "https://dash.notcms.com",
    "style": "roundedRectangle"
  },
  "tabs": [],
  "anchors": [
    {
      "name": "Templates",
      "icon": "rectangle-terminal",
      "url": "https://www.notcms.com/templates"
    },
    {
      "name": "Blog",
      "icon": "newspaper",
      "url": "https://www.notcms.com/blog"
    }
  ],
  "navigation": {
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["en/introduction", "en/quickstart"]
          },
          {
            "group": "Usage",
            "pages": [
              "en/usage/initializing-client",
              "en/usage/list",
              "en/usage/get",
              "en/usage/errors-and-rate-limits"
            ]
          },
          {
            "group": "CLI Commands",
            "pages": [
              "en/cli-commands/init",
              "en/cli-commands/pull",
              "en/cli-commands/migration",
              "en/cli-commands/schema-ci"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "en/examples/nextjs",
              "en/examples/blog-releases",
              "en/examples/content-recipes",
              "en/examples/astro"
            ]
          }
        ]
      },
      {
        "language": "ja",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["ja/introduction", "ja/quickstart"]
          },
          {
            "group": "Usage",
            "pages": [
              "ja/usage/initializing-client",
              "ja/usage/list",
              "ja/usage/get",
              "ja/usage/errors-and-rate-limits"
            ]
          },
          {
            "group": "CLI Commands",
            "pages": [
              "ja/cli-commands/init",
              "ja/cli-commands/pull",
              "ja/cli-commands/migration",
              "ja/cli-commands/schema-ci"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "ja/examples/nextjs",
              "ja/examples/blog-releases",
              "ja/examples/content-recipes",
              "ja/examples/astro"
            ]
          }
        ]
      }
    ]
  },
  "footerSocials": {
    "x": "https://x.com/notcmsjs",
    "github": "https://github.com/qqpann/notcms"
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "search": {
    "prompt": "Search documentation..."
  },
  "metadata": {
    "og:site_name": "NotCMS Documentation",
    "og:description": "Type-safe headless CMS powered by Notion",
    "twitter:site": "@notcmsjs"
  },
  "analytics": {
    "plausible": {
      "domain": "docs.notcms.com"
    }
  },
  "i18n": [
    {
      "locale": "en",
      "name": "English"
    },
    {
      "locale": "ja",
      "name": "日本語"
    }
  ]
}
