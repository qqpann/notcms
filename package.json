{
  "name": "notcms-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "format": "biome format --write .",
    "lint-biome": "biome lint --write .",
    "check": "biome check .",
    "prepare": "husky",
    "check:docs": "node scripts/check-docs.mjs",
    "test:docs": "node --test scripts/check-docs.test.mjs",
    "test:staged-publish": "node --test scripts/staged-publish.test.mjs",
    "test:sdk-releases": "node --test scripts/sdk-github-releases.test.mjs",
    "test:sync-release": "node --test scripts/sync-action-release.test.mjs",
    "test:dependency-security": "node --test scripts/dependency-security.test.mjs",
    "fix": "biome check --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --filter notcms --filter notcms-kit run build",
    "test": "pnpm --filter notcms exec vitest run && pnpm --filter notcms-sync-action test",
    "dev": "pnpm --filter notcms dev",
    "dev:isolated": "pnpm --filter blog-demo dev --port 4500"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.4",
    "turbo": "^2.9.14"
  },
  "engines": {
    "node": "^26.13.0",
    "pnpm": "^12"
  }
}
