{
  "name": "notcms-sync-action",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "description": "GitHub Action to sync NotCMS (Notion) content with repository Markdown files",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^8.0.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vercel/ncc": "^0.45.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
